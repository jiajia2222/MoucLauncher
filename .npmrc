registry=https://registry.npmmirror.com
# Recognised by electron's install script / electron-builder via npm_config_* env vars.
# npm prints an "Unknown project config" warning for these two lines; they still work,
# and without them a fresh `npm install` in mainland China downloads Electron from GitHub.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
