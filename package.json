{
  "name": "moucx",
  "version": "1.1.0",
  "description": "MoucX - 自研 Minecraft 启动器 (Windows)",
  "main": "out/main/index.js",
  "author": "jiajia2222",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "node scripts/dist-win.mjs",
    "dist:verify": "node scripts/verify-artifacts.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "pinia": "4.0.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.6.0": true
  }
}
